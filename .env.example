# --- AI provider ---
# "mock" (default) uses the built-in MockAIProvider - no external API calls,
# no API key required. Set to a real vendor once lib/ai/<vendor>.ts exists
# and is wired up in lib/ai/provider.ts.
AI_PROVIDER=mock

# Force mock mode regardless of AI_PROVIDER (handy for demos/tests).
MOCK_AI=true

# --- Uploads ---
# Maximum accepted upload size, in megabytes.
MAX_UPLOAD_MB=300
