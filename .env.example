# --- AI provider ---
# "mock" (default) uses the built-in MockAIProvider - no external API calls,
# no API key required. Set to a real vendor once lib/ai/<vendor>.ts exists
# and is wired up in lib/ai/provider.ts.
AI_PROVIDER=mock

# Force mock mode regardless of AI_PROVIDER (handy for demos/tests).
MOCK_AI=true

# --- Uploads ---
# Maximum accepted upload size, in megabytes.
MAX_UPLOAD_MB=300

# --- Render engine ---
# "remotion" (default, for now) renders via lib/video/remotion.ts
# (@remotion/bundler + @remotion/renderer, no timeline UI, no Remotion
# Studio exposed). "ffmpeg" uses the original engine in lib/video/render.ts.
# Both stay fully implemented and can be swapped with this one variable -
# see lib/video/engine.ts.
RENDER_ENGINE=remotion

# Optional: absolute path to an already-installed Chromium/Chrome binary.
# @remotion/renderer downloads its own headless Chrome on first use by
# default - set this only if that download is blocked in your environment
# (e.g. restricted outbound network) and you already have a compatible
# Chromium available. Leave unset to use Remotion's normal behavior.
# REMOTION_BROWSER_EXECUTABLE=/path/to/chrome
